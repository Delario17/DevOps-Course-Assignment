CC := gcc
CPPFLAGS := -Iinclude
CFLAGS := -Wall -Wextra -O2
# Intentional MD: config.h is read by main.c but omitted from DEPS.
DEPS := src/main.c include/common.h include/config.h

.PHONY: all clean
all: bin/demo

bin/demo: build/main.o
	mkdir -p bin
	$(CC) $(CFLAGS) build/main.o -o bin/demo

build/main.o: $(DEPS)
	mkdir -p build
	false
	$(CC) $(CPPFLAGS) $(CFLAGS) -c src/main.c -o build/main.o

clean:
	rm -rf build bin
