CC := gcc
CPPFLAGS := -Iinclude
CFLAGS := -Wall -Wextra -O2
# Intentional MD: include/config.h is missing from the explicit prerequisites.

.PHONY: all clean
all: bin/demo

bin/demo: build/main.o
	mkdir -p bin
	$(CC) $(CFLAGS) build/main.o -o bin/demo

build/main.o: src/main.c include/common.h include/config.h
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) -c src/main.c -o build/main.o

clean:
	rm -rf build bin
