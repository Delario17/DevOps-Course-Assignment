{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devops.nju.edu.cn/e2/a08-b08/error-report.schema.json",
  "title": "Build Dependency Error Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "subject",
    "detector",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "pattern": "^report-[a-z0-9-]{3,64}$"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "detector": {
      "enum": ["BUILDCHECKER", "ECHECKER", "INSTRUCTOR_ORACLE"]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Finding"
      }
    }
  },
  "$defs": {
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "commit", "configuration_id"],
      "properties": {
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "type",
        "target",
        "dependency",
        "build_file",
        "evidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^finding-[a-z0-9-]{3,64}$"
        },
        "type": {
          "enum": ["MISSING", "REDUNDANT"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "dependency": {
          "type": "string",
          "minLength": 1
        },
        "build_file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
